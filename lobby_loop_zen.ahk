else
    ShowTip(TITLE " v" VERSION " loaded.`n" HK_TOGGLE " = start/stop   " HK_SETTINGS " = settings   " HK_TEST " = self-test", 5000)
if migrated
    Log("Copied " migrated " file(s) from the old Fortnite AFK version")
